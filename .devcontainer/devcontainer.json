// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
    "name": "Ubuntu",
    // Start from the prebuilt image published to GHCR (now public) so Codespaces open in
    // seconds instead of building from the Dockerfile each time.
    // To FREEZE the environment for the workshop: cut a release (e.g. v3.0.0), wait for the
    // "Publish dev container image" Action, then change :latest to :3.0.0 here.
    "image": "ghcr.io/biosustain/dsp_workshop_datavizr:latest",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },

    // Features to add to the dev container. More info: https://containers.dev/features.
    // "features": {},

    // Use 'forwardPorts' to make a list of ports inside the container available locally.
    // "forwardPorts": [],

    // Use 'postCreateCommand' to run commands after the container is created.
    // "postCreateCommand": "uname -a",

    // Configure tool-specific properties.
    "customizations": {
        // Open the notebooks guide as soon as the Codespace is ready, so students
        // land on where they work.
        "codespaces": {
            "openFiles": ["notebooks/README.md"]
        },
        "vscode": {
            "extensions": [
                "REditorSupport.r",
                "george-alisson.html-preview-vscode",
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers",
                "GitHub.copilot",
                "GitHub.copilot-chat"
            ]
        }
    },   // ← FIXED: this comma was missing!

    // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
    // "remoteUser": "root"
}